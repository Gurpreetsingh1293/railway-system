# ============================================================
# railway.json — Railway.app deployment configuration
# SIH PS 26027 | RailBlock AI
#
# HOW TO USE:
#   1. Push this repo to GitHub
#   2. Go to railway.app → New Project → Deploy from GitHub
#   3. Railway will detect this file automatically
#   4. Add the PostgreSQL plugin from Railway's dashboard
#   5. Set the environment variables listed below for each service
# ============================================================

{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
