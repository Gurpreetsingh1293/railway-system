# ---- Backend ----
DB_URL=jdbc:postgresql://localhost:5432/railway_blocks
DB_USER=railway
DB_PASS=railway
PORT=8080
SCORING_MODE=RULE_BASED
SCORING_ML_SERVICE_URL=http://localhost:8000

# ---- Frontend (Vite build-time variable) ----
VITE_API_BASE_URL=http://localhost:8080
